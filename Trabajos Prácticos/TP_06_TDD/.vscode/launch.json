{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "Iniciar Backend (Servidor)",
            "cwd": "${workspaceFolder}/backend",
            "program": "${workspaceFolder}/backend/src/index.js",
            "skipFiles": [
                "<node_internals>/**"
            ],
            "console": "integratedTerminal"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debuguear Todos los Tests",
            "cwd": "${workspaceFolder}/backend",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--experimental-vm-modules",
                "./node_modules/jest/bin/jest.js",
                "--runInBand",
                "--verbose"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Debuguear Test Actual",
            "cwd": "${workspaceFolder}/backend",
            "runtimeExecutable": "node",
            "runtimeArgs": [
                "--experimental-vm-modules",
                "./node_modules/jest/bin/jest.js",
                "--runInBand",
                "${file}"
            ],
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen"
        }
    ]
}